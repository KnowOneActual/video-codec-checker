[flake8]
max-line-length = 100
extend-ignore = E203, E501, D107, D102, D103, D412, D403
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    htmlcov,
    .pytest_cache,
    .mypy_cache
per-file-ignores =
    tests/*:D100,D101,D102,D103,D104
    examples/*:D100,D101,D102,D103,D104
    setup.py:D100
